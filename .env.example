# ============================================================
# Deployment
# ============================================================
DEPLOYER_PRIVATE_KEY=0x...
CRE_ETH_PRIVATE_KEY=0x...          # Same key with 0x prefix — required by CRE CLI
ALCHEMY_API_KEY=your_alchemy_api_key
# Get from https://etherscan.io → account → API keys
ETHERSCAN_API_KEY=your_etherscan_key

# ============================================================
# ReliefTreasury deployment params
# ============================================================
# Sepolia Circle USDC (leave empty to use MockUSDC on localhost)
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Total program USDC cap (1000000000000 = $1,000,000 USDC)
PROGRAM_CAP=1000000000000
# Admin address (defaults to deployer if empty)
ADMIN_ADDRESS=
# Chainlink Forwarder — Sepolia CRE forwarder address
CHAINLINK_FORWARDER_ADDRESS=0x15fc6ae953e024d975e77382eeec56a9101f9f88

# ============================================================
# Instruxi API (scripts/)
# ============================================================
INSTRUXI_BASE_URL=https://enforcer-v2-dev.instruxi.dev/api/v1/enforcer
INSTRUXI_API_KEY=your_instruxi_api_key
# Privy JWT — expires every hour, refresh from browser DevTools before running scripts
INSTRUXI_ADMIN_JWT=
# From your Instruxi dashboard
INSTRUXI_TENANT_ID=

# ============================================================
# RWA Gateway (scripts/ + workflow/)
# ============================================================
RWA_GATEWAY_URL=https://rwa-gateway-staging.instruxi.dev
# Same Privy JWT as INSTRUXI_ADMIN_JWT
RWA_GATEWAY_JWT=

# ============================================================
# Deployed contract (fill after deploy)
# ============================================================
RELIEF_TREASURY_ADDRESS=
