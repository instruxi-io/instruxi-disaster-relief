# ============================================================
# Deployment
# ============================================================
DEPLOYER_PRIVATE_KEY=0x...
ALCHEMY_API_KEY=your_alchemy_api_key
ETHERSCAN_API_KEY=your_etherscan_key
ARBISCAN_API_KEY=your_arbiscan_key

# ============================================================
# ReliefTreasury deployment params
# ============================================================
# USDC address on target network (leave empty for mock on localhost)
USDC_ADDRESS=
# Per-recipient USDC cap in 6-decimal units (e.g. 50000000 = $50 USDC)
PER_RECIPIENT_CAP=50000000
# Total program USDC cap (e.g. 1000000000000 = $1,000,000 USDC)
PROGRAM_CAP=1000000000000
# Admin address (defaults to deployer if empty)
ADMIN_ADDRESS=
# Chainlink Forwarder address — add as authorized fulfiller
# Sepolia: 0x15fc6ae953e024d975e77382eeec56a9101f9f88
CHAINLINK_FORWARDER_ADDRESS=0x15fc6ae953e024d975e77382eeec56a9101f9f88

# ============================================================
# CRE Workflow (see workflow/.env)
# ============================================================
INSTRUXI_BASE_URL=https://api.instruxi.io
INSTRUXI_API_KEY=your_instruxi_api_key
RELIEF_TREASURY_ADDRESS=0x...
