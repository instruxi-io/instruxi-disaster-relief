# Privy app ID — from privy.io/dashboard or rwa-gateway /health endpoint
VITE_PRIVY_APP_ID=your_privy_app_id

# Enforcer URL
VITE_ENFORCER_URL=https://enforcer-v2-dev.instruxi.dev/api/v1/enforcer

# Deployed ReliefTreasury contract address (fill after deploy)
VITE_TREASURY_ADDRESS=0x...

# Sepolia RPC — use Alchemy for reliability (rpc.sepolia.org is unreliable)
VITE_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>

# Pre-fill the event ID for demo (optional — bytes32 hex of your event name)
VITE_DEFAULT_EVENT_ID=
