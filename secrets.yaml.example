# CRE secrets mapping — copy to secrets.yaml and fill in values.
# secrets.yaml is gitignored — NEVER commit the real file.
#
# The CRE CLI reads secret values from the .env variable names listed here.
# The workflow accesses them at runtime via:
#   runtime.getSecret({ id: "KEY_NAME" }).result().value

secretsNames:
  INSTRUXI_API_KEY:
    - INSTRUXI_API_KEY
  INSTRUXI_ADMIN_JWT:
    - INSTRUXI_ADMIN_JWT
