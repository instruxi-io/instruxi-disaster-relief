# secrets.yaml — CRE workflow secrets
# Copy to secrets.yaml (one directory above workflow/) and fill in values.
# This file is referenced by workflow/workflow.yaml as "../secrets.yaml".
# NEVER commit secrets.yaml to git.

# Instruxi API key — used by logCallback.ts to call Enforcer eligibility endpoint
INSTRUXI_API_KEY: ""

# RWA Gateway JWT — used by notifyGateway() to call POST /api/webhooks/cre
RWA_GATEWAY_JWT: ""

# Instruxi Admin JWT — used by onDisbursed/onDeposited to call POST /rwa/attestation/*
INSTRUXI_ADMIN_JWT: ""
