# CRE project settings — copy to project.yaml and fill in your Alchemy API key.
# project.yaml is gitignored because it contains your API key in the RPC URL.

staging-settings:
  rpcs:
    - chain-name: ethereum-testnet-sepolia
      url: "https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

production-settings:
  rpcs:
    - chain-name: ethereum-testnet-sepolia
      url: "https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
